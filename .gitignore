# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
.venv-dev/
*.log
gardyn.log
simulator/.sim/
# If using Jython
*.class
.env

# Browser-validation artifacts
.playwright-mcp/
garden-*.png
timelapse/

# Local secrets that must never reach git or the Pi (the Pi deploys via git,
# so anything ignored here can never be pushed to it). Home Assistant
# long-lived access token lives in .ha_token.
.ha_token
*.token
.update-pending

# Rotated logs: *.log above does not match mqtt.log.1 / gardyn.log.2.gz,
# and an 11k-line rotated log was committed once because of that gap.
*.log.*
