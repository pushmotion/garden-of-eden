# ── Device identity (Home Assistant discovery) ──
# Unique per tower. It namespaces the MQTT topics, the Home Assistant device,
# and every entity id (entities are <domain>.<MQTT_IDENTIFIER>_<suffix>), so
# running a second unit means changing only this line.
MQTT_IDENTIFIER=gardyn_01

# MQTT_BASETOPIC defaults to MQTT_IDENTIFIER. Leave it unset unless you are
# keeping an existing deployment on its old topics: setting the same value on
# two towers makes each receive the other's commands, because mqtt.py
# subscribes to BASE_TOPIC + "/#".
# MQTT_BASETOPIC=gardyn

MQTT_DEVICE_MODEL="gardyn 3.0"
MQTT_VERSION="1.0.0"

# ── MQTT broker ──
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=gardyn
MQTT_PASSWORD=somepassword
MQTT_KEEPALIVE_INTERVAL=60

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=gardyn.log

# ── pigpio connection ──
# Leave PIGPIO_HOST unset for local pigpiod. For Docker, point at the
# pigpiod container, e.g. PIGPIO_HOST=pigpiod / PIGPIO_PORT=8888.
#PIGPIO_HOST=
PIGPIO_PORT=8888

# ── Hardware model / sensors ──
# SENSOR_TYPE is auto-detected by bin/setup.sh (AM2320 or DHT20).
# GARDYN_MODEL forces a model instead of runtime auto-detection.
#GARDYN_MODEL=

# ── GPIO pins (BCM) ──
LIGHT_PIN=18
LIGHT_FREQUENCY=8000
PUMP_PIN=24
PUMP_FREQUENCY=50
DISTANCE_ECHO_PIN=19
DISTANCE_TRIGGER_PIN=26
BUTTON_PIN=13
OVER_TEMP_ALERT_PIN=25
DEFAULT_BRIGHTNESS=50
DEFAULT_PUMP_SPEED=100
# Hard safety cap on a single pump run (seconds). Schedules, the API, and the
# water CLI all clamp to this so the pump can never run longer. 300 = 5 minutes.
MAX_PUMP_RUN_SECONDS=300

# ── I2C addresses (decimal or 0x hex) ──
PCB_TEMP_ADDRESS=0x48
INA219_ADDRESS=0x40
OVER_TEMP_HIGH=36
OVER_TEMP_HYSTERESIS=34

# ── Water level alert ──
# Distance (cm) above which the tank is "low". 0 disables. This is the ALERT --
# early enough to be a useful "top me up" nudge. 11 = 60% remaining on the
# nominal geometry set below.
WATER_LOW_CM=11
# Airgap (cm) at which the pump is refused outright. Kept separate from the
# alert so that warning you does not also stop watering a tank that still has
# plenty: one value cannot be both an early warning and a late cutoff. Unset
# falls back to WATER_LOW_CM (the old single-threshold behaviour).
# 15.5 = 30% remaining on the nominal geometry set below.
PUMP_CUTOFF_CM=15.5
# How often (s) to re-read the tank and refresh the low-water alert.
WATER_CHECK_SECONDS=180
# How old (s) that reading may be and still gate the cron/CLI watering path.
# Past this, watering proceeds regardless, so a stopped service cannot withhold
# water indefinitely. Defaults to 3x WATER_CHECK_SECONDS.
#WATER_READING_MAX_AGE_SECONDS=540
ACTUATOR_POLL_SECONDS=15
# Tank geometry for the gallons readout: sensor->surface distance (cm) when full
# vs empty, and capacity in gallons (Home ~5, Studio ~4). Calibrate to your unit.
WATER_FULL_CM=5
WATER_EMPTY_CM=20
TANK_CAPACITY_GALLONS=5

# ── Camera ──
UPPER_CAMERA_DEVICE=/dev/video0
LOWER_CAMERA_DEVICE=/dev/video2
UPPER_IMAGE_PATH=/tmp/upper_camera.jpg
LOWER_IMAGE_PATH=/tmp/lower_camera.jpg
CAMERA_RESOLUTION="640x480"
IMAGE_INTERVAL_SECONDS=3600
# Timelapse: where archived frames/mp4s live, how many frames to keep, and the
# playback frame rate. Defaults store frames under the repo's timelapse/ dir.
# TIMELAPSE_DIR=
TIMELAPSE_MAX_FRAMES=720
TIMELAPSE_FPS=12
# Frames below which the UI warns there is little history yet (168 = 7 days hourly).
# A build still works at any count; short archives are just slowed down to run for
# roughly TIMELAPSE_TARGET_SECONDS instead of flashing past at the full frame rate.
TIMELAPSE_MIN_FRAMES=168
TIMELAPSE_TARGET_SECONDS=10

# ── REST API auth (optional) ──
# When set, non-localhost requests must send X-API-Key: <key>.
#GARDEN_API_KEY=

# ── State persistence ──
STATE_FILE=~/.garden_state.json
SCHEDULE_FILE=~/.garden_schedule.json
GROW_STATE_FILE=~/.garden_grow.json
# Per-pod plant tracking (Gardyn Home = 30 pods).
POD_COUNT=30
PODS_FILE=~/.garden_pods.json

# ── Grow-cycle reminders (days; 0 disables) ──
THINNING_REMINDER_DAYS=14
ROOT_CHECK_REMINDER_DAYS=21
HARVEST_REMINDER_DAYS=35
NUTRIENT_REMINDER_DAYS=14
RESERVOIR_CHANGE_DAYS=49

# ── External integrations (scaffolded) ──
ALEXA_ENABLED=false
THINGSBOARD_ENABLED=false
THINGSBOARD_HOST=
THINGSBOARD_TOKEN=
TELEGRAF_ENABLED=false
